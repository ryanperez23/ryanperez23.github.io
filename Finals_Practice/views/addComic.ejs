<%- include("partials/header", { title: "Add Comic" }) %>

<section class="form-section">

    <h2>New Comic</h2>

    <form action="/addComic" method="POST">

        <div class="mb-3">
            <label class="form-label">
                Title:
            </label>

            <input
                type="text"
                name="comicTitle"
                class="form-control"
                required>
        </div>

        <div class="mb-3">
            <label class="form-label">
                URL:
            </label>

            <input
                type="url"
                name="comicUrl"
                class="form-control"
                required>
        </div>

        <div class="mb-3">
            <label class="form-label">
                Publish Date:
            </label>

            <input
                type="date"
                name="comicDate"
                class="form-control"
                required>
        </div>

        <div class="mb-3">
            <label class="form-label">
                Web Site:
            </label>

            <select
                name="comicSiteId"
                class="form-select"
                required>

                <% sites.forEach(site => { %>

                    <option value="<%= site.comicSiteId %>">
                        <%= site.comicSiteName %>
                    </option>

                <% }) %>

            </select>
        </div>

        <button
            type="submit"
            class="btn btn-success">

            Submit New Comic

        </button>

    </form>

</section>

<%- include("partials/footer") %>