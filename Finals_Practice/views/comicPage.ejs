<%- include("partials/header.ejs") %>

<main class="container page-content">

    <!-- display comic website -->
    <h1>

        <a
            href="<%= site.comicSiteUrl %>"
            target="_blank">

            <%= site.comicSiteName %>

        </a>

    </h1>

    <!-- loop through comics -->
    <% comics.forEach(comic => { %>

        <div class="comic">

            <!-- display comic title -->
            <h3>

                <%= comic.comicTitle %>

            </h3>

            <!-- display comic image -->
            <img
                src="<%= comic.comicUrl %>"
                alt="<%= comic.comicTitle %>">

            <p>

                <!-- go to add comment page -->
                <a href="/addComment/<%= comic.comicId %>">

                    Add Comments

                </a>

                |

                <!-- display comments -->
                <a
                    href="#"
                    onclick="viewComments(<%= comic.comicId %>); return false;">

                    View Comments

                </a>

            </p>

        </div>

    <% }) %>

    <!-- return to home page -->
    <p>

        <a
            class="btn btn-secondary"
            href="/">

            Home

        </a>

    </p>

    <!-- bootstrap comments modal -->
    <div
        class="modal fade"
        id="commentsModal"
        tabindex="-1">

        <div class="modal-dialog">

            <div class="modal-content">

                <!-- modal header -->
                <div class="modal-header">

                    <h5 class="modal-title">

                        Comments

                    </h5>

                    <!-- close modal -->
                    <button
                        class="btn-close"
                        type="button"
                        data-bs-dismiss="modal">
                    </button>

                </div>

                <!-- comments will appear here -->
                <div
                    class="modal-body"
                    id="commentList">
                </div>

            </div>

        </div>

    </div>

    <%- include("partials/footer.ejs") %>

</main>

<!-- load javascript -->
<script src="/js/script.js"></script>