<%- include("partials/header", { title: "Add Comment" }) %>

<section class="form-section text-center">

    <h2>Adding Comments</h2>

    <h3>
        <%= comic.comicTitle %>
    </h3>

    <img
        class="selected-comic"
        src="<%= comic.comicUrl %>"
        alt="<%= comic.comicTitle %>">

    <form
        action="/addComment/<%= comic.comicId %>"
        method="POST">

        <div class="mb-3">

            <label class="form-label">
                Username:
            </label>

            <input
                type="text"
                name="author"
                class="form-control"
                required>

        </div>

        <div class="mb-3">

            <label class="form-label">
                Email Address:
            </label>

            <input
                type="email"
                name="email"
                class="form-control"
                required>

        </div>

        <div class="mb-3">

            <label class="form-label">
                Comment:
            </label>

            <textarea
                name="comment"
                class="form-control"
                required>
            </textarea>

        </div>

        <button
            type="submit"
            class="btn btn-success">

            Submit Comment

        </button>

    </form>

</section>

<%- include("partials/footer") %>